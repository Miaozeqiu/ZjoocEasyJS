{
    "manifest_version": 2,
    "name": "My Script",
    "version": "1.0",
    "description": "A brief description.",
    "icons": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "content_scripts": [
      {
        "matches": ["*://*.example.com/*"],
        "js": ["dist/main.js"]
      }
    ],
    "permissions": ["activeTab"]
  }
  